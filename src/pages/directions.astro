---
// src/pages/directions.astro
import Layout from "../layouts/Layout.astro";

const nearbyAreas = [
  {
    area: "From Miyawala Chowk",
    distance: "2.8 km",
    travelTime: "6–8 mins",
    route:
      "Head south-east along the main Balawala connecting road straight past Nakronda turn. The clinic is on the left before Malsi Puliya.",
  },
  {
    area: "From Harrawala Railway Station / Chowk",
    distance: "3.5 km",
    travelTime: "8–10 mins",
    route:
      "Drive via Harrawala-Balawala link road onto Balawala Main Road. Follow the road straight to the Malsi Puliya junction.",
  },
  {
    area: "From Dehradun ISBT / Rispana Bridge",
    distance: "9.5 km",
    travelTime: "20–25 mins",
    route:
      "Take Haridwar Bypass Road to Miyawala junction, turn right towards Balawala Main Road, and proceed towards Malsi Puliya.",
  },
  {
    area: "From Nakronda Village",
    distance: "1.9 km",
    travelTime: "4–5 mins",
    route:
      "Direct link road connecting into Balawala Main Road. Proceed 300 meters towards Malsi Puliya.",
  },
  {
    area: "From Doiwala / Jolly Grant Airport Route",
    distance: "14 km",
    travelTime: "25–30 mins",
    route:
      "Take Dehradun-Rishikesh Highway to Harrawala junction, then turn into the Balawala arterial road.",
  },
  {
    area: "From Raipur / Ring Road",
    distance: "7.2 km",
    travelTime: "15–18 mins",
    route:
      "Follow the 6-lane Ring Road down towards Miyawala, then connect smoothly to Balawala Main Road.",
  },
];
---

<Layout
  title="Google Map Directions & Clinic Directory | Uniyal Oro Dental Balawala"
  description="Step-by-step driving directions, transit routes, and Google Maps directory to Uniyal Oro Dental Clinic & Implant Centre near Malsi Puliya, Balawala, Dehradun."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-20 space-y-16">
    <!-- Header -->
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#E6FFFA] border border-[#0D9488]/40 shadow-xs">
        <span class="text-xs font-black text-[#0D9488] uppercase tracking-wider">🗺️ Navigation & Location Directory</span>
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[#0F2537]">
        Directions to Uniyal Oro Dental
      </h1>
      <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-2xl mx-auto">
        Find the quickest driving routes, public transit options, and landmarks to visit our clinic near Malsi Puliya in Balawala, Dehradun.
      </p>
    </header>

    <!-- Quick Directions & One-Click Navigation Strip -->
    <div class="rounded-3xl bg-gradient-to-r from-[#0F2537] to-[#1a3d5a] text-white p-6 sm:p-10 shadow-xl border-2 border-[#1E415E] flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-left">
        <span class="text-xs font-black uppercase tracking-wider text-[#0D9488]">GPS Destination Coordinates</span>
        <h2 class="text-2xl sm:text-3xl font-black text-white">Uniyal Oro Dental Clinic & Implant Centre</h2>
        <p class="text-xs sm:text-sm text-slate-300">
          Near Malsi Puliya, Balawala Main Road, Dehradun, Uttarakhand 248008 · Regd. No-4135
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="https://maps.google.com/?q=Uniyal+Oro+Dental+Clinic+Balawala+Dehradun"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-black text-sm text-white bg-[#0D9488] hover:bg-[#0F766E] shadow-lg shadow-[#0D9488]/30 transition-all"
        >
          <span>Open in Google Maps Navigation</span>
          <span>↗</span>
        </a>
        <a
          href="tel:+917018021512"
          class="inline-flex items-center gap-1.5 px-5 py-3.5 rounded-xl font-bold text-sm text-slate-200 bg-white/10 hover:bg-white/20 transition-all"
        >
          <span>📞 Call Clinic for Directions</span>
        </a>
      </div>
    </div>

    <!-- Interactive Embed & Direct Details Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Embedded Google Map Frame (7 Cols) -->
      <div class="lg:col-span-7 rounded-3xl overflow-hidden border-2 border-[#CBD5E1] shadow-lg bg-white space-y-0">
        <div class="p-4 bg-slate-50 border-b border-[#CBD5E1] flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#0D9488] animate-pulse"></span>
            <span class="text-xs font-black text-[#0F2537] uppercase tracking-wider">Live Google Map Satellite View</span>
          </div>
          <span class="text-xs font-bold text-[#0D9488]">Balawala Main Road</span>
        </div>

        <div class="w-full h-[450px] sm:h-[500px]">
          <iframe
            title="Interactive Google Map Directions to Uniyal Oro Dental Balawala"
            src="https://maps.google.com/maps?q=30.2789,78.1065&t=&z=15&ie=UTF8&iwloc=&output=embed"
            class="w-full h-full border-0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="p-5 bg-white flex flex-col sm:flex-row items-center justify-between gap-3 text-xs border-t border-slate-100">
          <div class="text-slate-600 font-medium">
            <strong class="text-[#0F2537]">Landmark:</strong> Exactly 100 meters before Malsi Puliya crossing on Balawala Main Road.
          </div>
          <a
            href="https://maps.google.com/?q=Uniyal+Oro+Dental+Clinic+Balawala+Dehradun"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#0D9488] font-black hover:underline inline-flex items-center gap-1"
          >
            Start Turn-by-Turn GPS <span>→</span>
          </a>
        </div>
      </div>

      <!-- Facility Specs & Arrival Guide (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Parking & Entrance Card -->
        <div class="p-6 sm:p-8 rounded-3xl border-2 border-[#CBD5E1] bg-white shadow-sm space-y-5">
          <div class="border-b border-slate-100 pb-3">
            <span class="text-xs font-black uppercase tracking-wider text-[#0D9488]">Facility Accessibility</span>
            <h3 class="text-xl sm:text-2xl font-black text-[#0F2537] mt-1">Arrival & Parking Guide</h3>
          </div>

          <ul class="space-y-3.5 text-xs sm:text-sm text-slate-700 font-medium">
            <li class="flex items-start gap-3">
              <span class="w-7 h-7 rounded-lg bg-teal-50 border border-teal-200 text-[#0D9488] flex items-center justify-center shrink-0 font-bold">🅿️</span>
              <div>
                <strong class="text-[#0F2537] block">Dedicated Patient Parking:</strong>
                Ample designated slots for two-wheelers and cars right outside the entrance without street congestion.
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-7 h-7 rounded-lg bg-teal-50 border border-teal-200 text-[#0D9488] flex items-center justify-center shrink-0 font-bold">♿</span>
              <div>
                <strong class="text-[#0F2537] block">Step-Free Wheelchair Access:</strong>
                Ground-level entry designed comfortably for senior citizens, patients with restricted mobility, and strollers.
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-7 h-7 rounded-lg bg-teal-50 border border-teal-200 text-[#0D9488] flex items-center justify-center shrink-0 font-bold">🚌</span>
              <div>
                <strong class="text-[#0F2537] block">Public Transit & Vikram Stop:</strong>
                Local Balawala autos and Vikram route #5 drop off right opposite our clinic gate.
              </div>
            </li>
          </ul>
        </div>

        <!-- Clinic Timings for Visitors -->
        <div class="p-6 sm:p-8 rounded-3xl border-2 border-[#CBD5E1] bg-white shadow-sm space-y-4">
          <h3 class="text-lg font-black text-[#0F2537] border-b border-slate-100 pb-3">Consultation Hours</h3>
          <div class="space-y-2 text-xs sm:text-sm text-slate-700">
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="font-bold">Mon – Sat (Morning)</span>
              <span class="font-semibold text-[#0F2537]">09:30 AM – 01:00 PM</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="font-bold">Mon – Sat (Evening)</span>
              <span class="font-semibold text-[#0F2537]">04:00 PM – 09:00 PM</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="font-bold">Sunday</span>
              <span class="font-bold text-emerald-700">By Prior Appointment</span>
            </div>
          </div>

          <div class="pt-3">
            <a
              href="/appointment"
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-xs font-black text-white bg-[#0D9488] hover:bg-[#0F766E] shadow-sm transition-all"
            >
              <span>Book Appointment Slot Before Arriving</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Locality Driving Directory (Step-by-step from nearby hubs) -->
    <section class="space-y-6">
      <div class="space-y-2 text-left">
        <span class="text-xs font-black uppercase tracking-wider text-[#0D9488]">Area Directory</span>
        <h2 class="text-2xl sm:text-4xl font-black text-[#0F2537]">
          Directions From Nearby Localities in Dehradun
        </h2>
        <p class="text-sm text-slate-600">
          Our clinic is centrally accessible from all major residential areas of east and south Dehradun.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {nearbyAreas.map((item) => (
          <div class="p-6 rounded-2xl border-2 border-[#CBD5E1] bg-white shadow-xs space-y-3 hover:border-[#0D9488] transition-colors">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-black text-[#0F2537]">
                {item.area}
              </h3>
              <div class="flex items-center gap-1.5 text-[11px] font-extrabold px-2 py-0.5 rounded bg-teal-50 text-[#0D9488] border border-teal-200">
                <span>{item.distance}</span>
                <span>·</span>
                <span>{item.travelTime}</span>
              </div>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed">
              {item.route}
            </p>

            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400">Via Balawala Main Rd</span>
              <a
                href={`https://maps.google.com/?daddr=Uniyal+Oro+Dental+Clinic+Balawala+Dehradun&saddr=${encodeURIComponent(item.area)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-black text-[#0D9488] hover:underline inline-flex items-center gap-1"
              >
                Get GPS Route ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
