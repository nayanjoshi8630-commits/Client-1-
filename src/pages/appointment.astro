---
// src/pages/appointment.astro
import Layout from "../layouts/Layout.astro";

const treatmentsList = [
  "General Dental Checkup & Digital Consultation",
  "Dental Implants & 3D Bone Planning",
  "Single-Sitting Laser Root Canal (RCT)",
  "Clear Invisible Aligners & Orthodontics",
  "Cosmetic Smile Designing, Veneers & Whitening",
  "Pediatric & Child Gentle Dental Care",
  "Wisdom Tooth Pain & Surgical Extraction",
  "Teeth Ultrasonic Cleaning, Scaling & Polish",
  "Emergency Toothache / Swelling Relief",
];

const timeSlots = [
  "Morning: 09:30 AM – 11:00 AM",
  "Midday: 11:00 AM – 01:00 PM",
  "Evening: 04:00 PM – 06:30 PM",
  "Night: 06:30 PM – 09:00 PM",
];
---

<Layout
  title="Book Dental Appointment | Uniyal Oro Dental Clinic Balawala"
  description="Book your dental appointment online at Uniyal Oro Dental Clinic & Implant Centre, Balawala, Dehradun. Transparent pricing, painless care, zero wait times."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-20 space-y-16">
    <!-- Header -->
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#E6FFFA] border border-[#0D9488]/40 shadow-xs">
        <span class="w-2.5 h-2.5 rounded-full bg-[#0D9488] animate-pulse"></span>
        <span class="text-xs font-black text-[#0D9488] uppercase tracking-wider">Fast Online Booking & Same-Day Slots</span>
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[#0F2537]">
        Book Your Dental Appointment
      </h1>
      <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-2xl mx-auto">
        Reserve your consultation slot with Dr. Ashish Uniyal. We ensure zero long waiting lines, thorough diagnosis, and gentle, stress-free care.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left: Appointment Booking Form (7 Cols) -->
      <div class="lg:col-span-7 rounded-3xl border-2 border-[#CBD5E1] bg-white p-6 sm:p-10 shadow-md space-y-8">
        <div class="space-y-2 border-b border-slate-100 pb-5">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl sm:text-3xl font-black text-[#0F2537]">
              Patient Consultation Form
            </h2>
            <span class="text-xs font-black px-3 py-1 rounded-full bg-[#E6FFFA] text-[#0D9488] border border-[#0D9488]/30">
              Instant Confirmation
            </span>
          </div>
          <p class="text-xs sm:text-sm text-slate-600">
            Submit your appointment details below. You will receive an instant confirmation call and WhatsApp receipt.
          </p>
        </div>

        <form id="appointmentPageForm" class="space-y-6" novalidate>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Patient Name -->
            <div class="space-y-2 text-left">
              <label for="app-name" class="block text-xs font-black uppercase tracking-wider text-[#0F2537]">
                Patient Full Name <span class="text-rose-500">*</span>
              </label>
              <input
                id="app-name"
                name="name"
                type="text"
                required
                minlength="2"
                maxlength="100"
                placeholder="e.g. Ramesh Joshi"
                class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 bg-slate-50 text-sm font-semibold text-[#0F2537] focus:outline-none focus:border-[#0D9488] focus:bg-white transition-all"
              />
            </div>

            <!-- Phone Number -->
            <div class="space-y-2 text-left">
              <label for="app-phone" class="block text-xs font-black uppercase tracking-wider text-[#0F2537]">
                WhatsApp / Mobile Number <span class="text-rose-500">*</span>
              </label>
              <input
                id="app-phone"
                name="phone"
                type="tel"
                required
                placeholder="e.g. 9876543210"
                class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 bg-slate-50 text-sm font-semibold text-[#0F2537] focus:outline-none focus:border-[#0D9488] focus:bg-white transition-all"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Treatment Selection -->
            <div class="space-y-2 text-left">
              <label for="app-treatment" class="block text-xs font-black uppercase tracking-wider text-[#0F2537]">
                Select Treatment / Problem <span class="text-rose-500">*</span>
              </label>
              <select
                id="app-treatment"
                name="treatment"
                class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 bg-slate-50 text-sm font-semibold text-[#0F2537] focus:outline-none focus:border-[#0D9488] focus:bg-white transition-all cursor-pointer"
              >
                {treatmentsList.map((t) => (
                  <option value={t}>{t}</option>
                ))}
              </select>
            </div>

            <!-- Preferred Time Slot -->
            <div class="space-y-2 text-left">
              <label for="app-timeslot" class="block text-xs font-black uppercase tracking-wider text-[#0F2537]">
                Preferred Time Slot <span class="text-rose-500">*</span>
              </label>
              <select
                id="app-timeslot"
                name="timeSlot"
                class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 bg-slate-50 text-sm font-semibold text-[#0F2537] focus:outline-none focus:border-[#0D9488] focus:bg-white transition-all cursor-pointer"
              >
                {timeSlots.map((s) => (
                  <option value={s}>{s}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Preferred Date -->
            <div class="space-y-2 text-left">
              <label for="app-date" class="block text-xs font-black uppercase tracking-wider text-[#0F2537]">
                Preferred Appointment Date <span class="text-rose-500">*</span>
              </label>
              <input
                id="app-date"
                name="preferredDate"
                type="date"
                required
                class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 bg-slate-50 text-sm font-semibold text-[#0F2537] focus:outline-none focus:border-[#0D9488] focus:bg-white transition-all cursor-pointer"
              />
            </div>

            <!-- Patient City / Locality -->
            <div class="space-y-2 text-left">
              <label for="app-locality" class="block text-xs font-black uppercase tracking-wider text-[#0F2537]">
                Your Locality in Dehradun
              </label>
              <input
                id="app-locality"
                name="locality"
                type="text"
                placeholder="e.g. Balawala, Miyawala, Harrawala..."
                class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 bg-slate-50 text-sm font-semibold text-[#0F2537] focus:outline-none focus:border-[#0D9488] focus:bg-white transition-all"
              />
            </div>
          </div>

          <!-- Notes / Description -->
          <div class="space-y-2 text-left">
            <label for="app-notes" class="block text-xs font-black uppercase tracking-wider text-[#0F2537]">
              Dental Symptoms or Questions (Optional)
            </label>
            <textarea
              id="app-notes"
              name="notes"
              rows="3"
              maxlength="500"
              placeholder="Describe any tooth pain, sensitivity, swelling, or past dental work..."
              class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 bg-slate-50 text-sm font-semibold text-[#0F2537] focus:outline-none focus:border-[#0D9488] focus:bg-white transition-all resize-y"
            ></textarea>
          </div>

          <!-- Status Message Box -->
          <div id="appointmentStatusBox" class="hidden p-4 rounded-xl text-sm font-bold"></div>

          <!-- Submit CTA Button -->
          <button
            id="appointmentSubmitBtn"
            type="submit"
            class="w-full min-h-[52px] py-4 px-6 rounded-xl font-black text-base text-white bg-[#0D9488] hover:bg-[#0F766E] shadow-lg shadow-[#0D9488]/30 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span id="appointmentBtnLabel">Confirm Dental Appointment</span>
          </button>
        </form>
      </div>

      <!-- Right: Doctor Guarantee & Clinic Info (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Direct Quick Connect Box -->
        <div class="rounded-3xl border-2 border-[#CBD5E1] bg-white p-6 sm:p-8 shadow-sm space-y-5">
          <div class="space-y-1">
            <span class="text-xs font-black uppercase tracking-wider text-[#0D9488]">Direct Contact Channels</span>
            <h3 class="text-xl sm:text-2xl font-black text-[#0F2537]">Need Urgent Assistance?</h3>
            <p class="text-xs sm:text-sm text-slate-600">Call or message Dr. Uniyal directly if you have acute tooth pain or dental trauma.</p>
          </div>

          <div class="space-y-3 pt-2">
            <a
              href="tel:+917018021512"
              class="w-full flex items-center justify-between p-4 rounded-2xl bg-slate-50 border border-slate-200 hover:border-[#0D9488] transition-colors group"
            >
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#E6FFFA] text-[#0D9488] flex items-center justify-center text-lg">
                  📞
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-500">Direct Telephone Line</p>
                  <p class="text-sm font-black text-[#0F2537] group-hover:text-[#0D9488]">+91 70180 21512</p>
                </div>
              </div>
              <span class="text-xs font-bold text-[#0D9488]">Call Now →</span>
            </a>

            <a
              href="https://wa.me/917018021512?text=Hello%20Dr.%20Uniyal,%20I%20would%20like%20to%20book%20an%20urgent%20appointment."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-between p-4 rounded-2xl bg-emerald-50/60 border border-emerald-200 hover:border-[#25D366] transition-colors group"
            >
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#25D366] text-white flex items-center justify-center text-lg">
                  💬
                </div>
                <div>
                  <p class="text-xs font-bold text-emerald-800">WhatsApp Help Desk</p>
                  <p class="text-sm font-black text-emerald-950">Chat & Share Reports</p>
                </div>
              </div>
              <span class="text-xs font-bold text-emerald-700">Chat Now →</span>
            </a>
          </div>
        </div>

        <!-- Clinic Timings Card -->
        <div class="rounded-3xl border-2 border-[#CBD5E1] bg-white p-6 sm:p-8 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h4 class="text-base font-black text-[#0F2537]">Clinic Operating Hours</h4>
            <span class="text-[11px] font-black text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full">Open Today</span>
          </div>

          <div class="space-y-2.5 text-xs sm:text-sm text-slate-700">
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="font-bold">Monday – Saturday</span>
              <span class="font-semibold text-right">09:30 AM – 01:00 PM<br />04:00 PM – 09:00 PM</span>
            </div>
            <div class="flex justify-between py-1 border-b border-slate-100">
              <span class="font-bold">Sunday</span>
              <span class="font-semibold text-emerald-700 text-right">By Prior Appointment Only</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="font-bold">Address</span>
              <span class="font-semibold text-right text-slate-600">Near Malsi Puliya, Balawala Main Rd, Dehradun</span>
            </div>
          </div>

          <a
            href="/directions"
            class="w-full inline-flex items-center justify-center gap-1.5 py-2.5 px-4 rounded-xl text-xs font-bold text-[#0D9488] bg-[#E6FFFA] hover:bg-teal-100 transition-colors"
          >
            <span>📍 View Road Route & Google Maps Directory</span>
            <span>→</span>
          </a>
        </div>

        <!-- Patient Guarantee Card -->
        <div class="p-6 rounded-3xl bg-slate-900 text-white space-y-3">
          <h4 class="text-base font-black text-white flex items-center gap-2">
            <span class="text-[#0D9488]">★</span> The Uniyal Oro Clinic Guarantee
          </h4>
          <ul class="text-xs text-slate-300 space-y-2">
            <li class="flex items-start gap-2">
              <span class="text-[#0D9488] font-bold">✓</span>
              <span><strong>Zero Wait Guarantee:</strong> Confirmed appointments are seated promptly on schedule.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0D9488] font-bold">✓</span>
              <span><strong>100% Sterile:</strong> Pouch-sealed autoclaved instruments opened right in front of you.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0D9488] font-bold">✓</span>
              <span><strong>Painless Care:</strong> Micro-anesthesia techniques ensuring maximum procedural comfort.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupAppointmentPage() {
    const form = document.getElementById("appointmentPageForm") as HTMLFormElement | null;
    const statusBox = document.getElementById("appointmentStatusBox");
    const submitBtn = document.getElementById("appointmentSubmitBtn") as HTMLButtonElement | null;
    const btnLabel = document.getElementById("appointmentBtnLabel");

    // Set minimum date to today
    const dateInput = document.getElementById("app-date") as HTMLInputElement | null;
    if (dateInput) {
      const today = new Date().toISOString().split("T")[0];
      if (today) {
        dateInput.min = today;
        dateInput.value = today;
      }
    }

    if (!form || !statusBox || !submitBtn || !btnLabel) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      statusBox.classList.add("hidden");
      statusBox.className = "p-4 rounded-xl text-sm font-bold";

      const formData = new FormData(form);
      const name = formData.get("name")?.toString().trim() ?? "";
      const phone = formData.get("phone")?.toString().trim() ?? "";
      const treatment = formData.get("treatment")?.toString().trim() ?? "";
      const timeSlot = formData.get("timeSlot")?.toString().trim() ?? "";
      const preferredDate = formData.get("preferredDate")?.toString().trim() ?? "";
      const locality = formData.get("locality")?.toString().trim() ?? "";
      const notes = formData.get("notes")?.toString().trim() ?? "";

      if (!name || name.length < 2) {
        statusBox.classList.remove("hidden");
        statusBox.classList.add("bg-rose-50", "text-rose-700", "border", "border-rose-200");
        statusBox.textContent = "Please enter the patient's full name (at least 2 letters).";
        return;
      }

      if (!phone || phone.length < 10) {
        statusBox.classList.remove("hidden");
        statusBox.classList.add("bg-rose-50", "text-rose-700", "border", "border-rose-200");
        statusBox.textContent = "Please enter a valid 10-digit mobile or WhatsApp number.";
        return;
      }

      // UI Loading state
      submitBtn.disabled = true;
      btnLabel.textContent = "Confirming Appointment Slot...";

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name,
            phone,
            treatment,
            preferredDate: `${preferredDate} (${timeSlot})`,
            message: `${locality ? `Locality: ${locality}. ` : ""}${notes}`,
          }),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          statusBox.classList.remove("hidden");
          statusBox.classList.add("bg-teal-50", "text-[#0D9488]", "border", "border-[#0D9488]/40");
          statusBox.innerHTML = `
            <div class="space-y-1">
              <p class="font-black text-base">🎉 Appointment Request Confirmed!</p>
              <p class="text-xs text-slate-700 font-semibold">Thank you ${name}. Our clinical coordinator will call/WhatsApp you at <strong>${phone}</strong> within 30 minutes to confirm your token.</p>
              <div class="pt-2">
                <a href="https://wa.me/917018021512?text=Hello%20Dr.%20Uniyal,%20I%20just%20booked%20an%20appointment%20online%20for%20${encodeURIComponent(treatment)}." target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#25D366] text-white text-xs font-bold shadow-xs">
                  Open WhatsApp Chat Confirmation →
                </a>
              </div>
            </div>
          `;
          form.reset();
        } else {
          statusBox.classList.remove("hidden");
          statusBox.classList.add("bg-rose-50", "text-rose-700", "border", "border-rose-200");
          statusBox.textContent = result.message || "Booking request failed. Please call us directly at +91 70180 21512.";
        }
      } catch (err) {
        statusBox.classList.remove("hidden");
        statusBox.classList.add("bg-rose-50", "text-rose-700", "border", "border-rose-200");
        statusBox.textContent = "Network error. Please call +91 70180 21512 or message on WhatsApp for instant booking.";
      } finally {
        submitBtn.disabled = false;
        btnLabel.textContent = "Confirm Dental Appointment";
      }
    });
  }

  setupAppointmentPage();
  document.addEventListener("astro:after-swap", setupAppointmentPage);
</script>
