---
// src/components/ui/Testimonials.astro
const reviews = [
  {
    name: "Vikram Negi",
    location: "Balawala Resident",
    treatment: "Single-Sitting RCT & Crown",
    rating: 5,
    text: "I was extremely anxious about my root canal, but Dr. Ashish Uniyal completed the entire treatment painlessly in one sitting! The clinic is spotless and state-of-the-art.",
    date: "2 weeks ago",
  },
  {
    name: "Pooja Rawat",
    location: "Miyawala, Dehradun",
    treatment: "Clear Aligners",
    rating: 5,
    text: "Started my teeth alignment with invisible aligners here. Zero metal brackets, no food restrictions, and Dr. Uniyal explains every stage with genuine care and patience.",
    date: "1 month ago",
  },
  {
    name: "Col. R. S. Bhandari (Retd.)",
    location: "Harrawala",
    treatment: "Titanium Dental Implants",
    rating: 5,
    text: "Got two titanium implants placed. Precise 3D guidance, no pain during or after surgery, and now I can chew comfortably like before. Highly recommended in Dehradun!",
    date: "2 months ago",
  },
];
---

<section class="py-16 md:py-24 bg-[#F8FAFC] border-t border-[#E2E8F0]" id="reviews-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E6FFFA] border border-[#0D9488]/40 text-xs font-black text-[#0D9488] uppercase tracking-wider">
        <span>⭐ Verified Google Patient Reviews</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-[#0F2537] tracking-tight">
        Trusted by Over 2,500+ Happy Smiles
      </h2>
      <p class="text-base sm:text-lg text-[#334155] font-medium leading-relaxed">
        Read real, unfiltered experiences from families across Balawala, Miyawala, Harrawala, and Dehradun.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {reviews.map((r) => (
        <article class="p-6 sm:p-7 rounded-2xl bg-white border-2 border-[#CBD5E1] shadow-xs flex flex-col justify-between space-y-4 hover:border-[#0D9488] transition-colors">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1 text-amber-500 font-black text-sm">
                {"★".repeat(r.rating)}
              </div>
              <span class="text-[11px] font-bold text-slate-500">{r.date}</span>
            </div>

            <p class="text-sm text-slate-700 leading-relaxed italic">
              "{r.text}"
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <h3 class="text-sm font-extrabold text-[#0F2537]">{r.name}</h3>
              <p class="text-xs text-slate-600">{r.location}</p>
            </div>
            <span class="text-[10px] font-bold px-2 py-1 rounded bg-emerald-50 text-emerald-950 border border-emerald-300">
              {r.treatment}
            </span>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center pt-2">
      <a
        href="/reviews"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold text-[#0D9488] bg-[#E6FFFA] hover:bg-teal-100 border border-[#0D9488]/30 transition-all"
      >
        <span>Read All 43+ Patient Reviews & Stories</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>
