---
// src/components/ui/Header.astro
const pathname = Astro.url.pathname;

const treatmentLinks = [
  {
    title: "Dental Implants & Full Mouth",
    desc: "Lifetime titanium tooth root restoration & 3D guided surgery",
    href: "/treatments#implants",
    badge: "Specialized",
    icon: `<svg class="w-5 h-5 text-[#0D9488]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.5 2 6 4.5 6 7.5c0 2 .8 4.2 1.5 6.5.8 2.5 1.5 5 2.5 7 1 .5 2 1 2 .5.5-2.5 1.2-5 2-7.5.7-2.3 1.5-4.5 1.5-6.5C18 4.5 15.5 2 12 2z"></path><path d="M9.5 7.5a2.5 2.5 0 0 1 5 0"></path></svg>`,
  },
  {
    title: "Single-Sitting Laser RCT",
    desc: "Painless computerized rotary root canal in 45 minutes",
    href: "/treatments#rct",
    badge: "Painless",
    icon: `<svg class="w-5 h-5 text-[#0D9488]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>`,
  },
  {
    title: "Clear Aligners & Braces",
    desc: "Discreet transparent teeth straightening without metal wires",
    href: "/treatments#orthodontics",
    badge: "Orthodontics",
    icon: `<svg class="w-5 h-5 text-[#0D9488]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="3"></rect><path d="M7 8h10M7 12h10M7 16h10"></path></svg>`,
  },
  {
    title: "Smile Designing & Veneers",
    desc: "Ultra-thin porcelain veneers & chairside laser teeth whitening",
    href: "/treatments#cosmetic",
    badge: "Cosmetic",
    icon: `<svg class="w-5 h-5 text-[#0D9488]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>`,
  },
  {
    title: "Pediatric & Family Care",
    desc: "Gentle child dental checkups, cavity guards & fluoride care",
    href: "/treatments#pediatric",
    badge: "Kids Care",
    icon: `<svg class="w-5 h-5 text-[#0D9488]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path></svg>`,
  },
  {
    title: "Oral Surgery & Extractions",
    desc: "Atraumatic wisdom tooth removal & surgical root care",
    href: "/treatments#surgery",
    badge: "Surgical",
    icon: `<svg class="w-5 h-5 text-[#0D9488]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`,
  },
];

const primaryNavItems = [
  { label: "Treatments", href: "/treatments", hasDropdown: true },
  { label: "Smile Gallery", href: "/gallery", hasDropdown: false },
  { label: "About Doctors", href: "/about", hasDropdown: false },
  { label: "Reviews", href: "/reviews", hasDropdown: false },
  { label: "Contact & Directions", href: "/contact", hasDropdown: false },
];
---

<!-- Top Utility & Emergency Bar -->
<div class="bg-[#0F2537] text-[#F8FAFC] text-[12px] sm:text-[13px] border-b border-slate-800 z-50 relative py-1.5 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-y-1 gap-x-4">
    <div class="flex items-center gap-2 font-medium">
      <span class="w-2 h-2 rounded-full bg-[#0D9488] animate-pulse shrink-0"></span>
      <span class="text-slate-300">
        <strong class="text-white font-semibold">Balawala, Dehradun</strong>
        <span class="hidden sm:inline"> · Near Malsi Puliya</span>
        <span class="text-slate-400 mx-1">|</span>
        <span class="text-emerald-300 font-medium">Open Today until 9:00 PM</span>
      </span>
    </div>

    <div class="flex items-center gap-3 sm:gap-5 text-xs font-medium">
      <a
        href="https://maps.google.com/?q=Uniyal+Oro+Dental+Clinic+Balawala+Dehradun"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-1 text-slate-300 hover:text-white transition-colors"
      >
        <span>📍 Directions</span>
      </a>
      <a
        href="https://wa.me/917018021512?text=Hello%20Uniyal%20Dental%20Clinic,%20I%20would%20like%20to%20book%20a%20consultation."
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1 text-[#25D366] hover:text-emerald-300 transition-colors font-semibold"
      >
        <span>💬 WhatsApp</span>
      </a>
      <a
        href="tel:+917018021512"
        class="inline-flex items-center gap-1.5 text-white hover:text-[#0D9488] transition-colors font-bold"
        aria-label="Call clinic directly at +91 70180 21512"
      >
        <span class="text-[#0D9488]">📞</span>
        <span class="hidden xs:inline text-slate-300 font-normal">Emergency:</span>
        <span class="underline decoration-[#0D9488] underline-offset-2">+91 70180 21512</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header id="main-header" class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-[#E2E8F0] shadow-xs transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">
    <!-- Left: Brand Logo & Clinic Name -->
    <a
      href="/"
      class="flex items-center gap-3 text-[#0F2537] group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0D9488] rounded-md shrink-0"
      aria-label="Uniyal Oro Dental Clinic & Implant Centre Home"
    >
      <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#E6FFFA] to-teal-100 border border-[#0D9488]/30 flex items-center justify-center text-[#0D9488] transition-transform duration-200 group-hover:scale-105 shrink-0 shadow-xs">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2C8.5 2 6 4.5 6 7.5c0 2 .8 4.2 1.5 6.5.8 2.5 1.5 5 2.5 7 1 .5 2 1 2 .5.5-2.5 1.2-5 2-7.5.7-2.3 1.5-4.5 1.5-6.5C18 4.5 15.5 2 12 2z"></path>
          <path d="M9.5 7.5a2.5 2.5 0 0 1 5 0"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-base sm:text-lg font-extrabold tracking-tight text-[#0F2537] group-hover:text-[#0D9488] transition-colors leading-tight">
          Uniyal Oro Dental
        </span>
        <span class="text-[11px] font-semibold text-[#475569] tracking-wider uppercase">
          & Implant Centre · Balawala
        </span>
      </div>
    </a>

    <!-- Center: Desktop Navigation Bar with Treatments Mega-Dropdown -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
      <!-- Treatments Mega-Menu Item -->
      <div class="relative group" id="treatments-dropdown-container">
        <button
          type="button"
          id="treatments-menu-trigger"
          class:list={[
            "inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold rounded-lg transition-colors cursor-pointer",
            pathname.startsWith("/treatments")
              ? "text-[#0D9488] font-bold"
              : "text-[#475569] hover:text-[#0F2537] hover:bg-slate-50"
          ]}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="treatments-dropdown-panel"
        >
          <span>Treatments</span>
          <svg
            id="treatments-chevron"
            class="w-4 h-4 transition-transform duration-200 text-slate-400 group-hover:text-[#0D9488]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Treatments Dropdown Panel -->
        <div
          id="treatments-dropdown-panel"
          class="hidden group-hover:block hover:block absolute top-full left-1/2 -translate-x-1/2 w-[560px] pt-2 z-50 transition-all duration-200"
        >
          <div class="bg-white rounded-2xl border border-[#E2E8F0] shadow-xl p-4 sm:p-5 overflow-hidden">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
              <span class="text-xs font-bold uppercase tracking-wider text-[#0D9488]">
                Clinical Procedures & Care
              </span>
              <a
                href="/treatments"
                class="text-xs font-semibold text-[#0D9488] hover:text-[#0F766E] hover:underline flex items-center gap-1"
              >
                View all procedures <span>→</span>
              </a>
            </div>

            <!-- Treatment Grid (2 columns) -->
            <div class="grid grid-cols-2 gap-2">
              {treatmentLinks.map((item) => (
                <a
                  href={item.href}
                  class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors border border-transparent hover:border-slate-100"
                >
                  <div class="w-9 h-9 rounded-lg bg-[#E6FFFA] border border-[#0D9488]/20 flex items-center justify-center shrink-0 group-hover/item:scale-105 transition-transform" set:html={item.icon} />
                  <div class="space-y-0.5">
                    <div class="text-xs font-bold text-[#0F2537] group-hover/item:text-[#0D9488] transition-colors leading-snug">
                      {item.title}
                    </div>
                    <p class="text-[11px] text-slate-500 line-clamp-1 leading-snug">
                      {item.desc}
                    </p>
                  </div>
                </a>
              ))}
            </div>

            <!-- Banner at bottom of dropdown -->
            <div class="mt-3 pt-3 border-t border-slate-100 bg-slate-50/70 -mx-4 -mb-4 p-3 px-5 flex items-center justify-between text-xs rounded-b-2xl">
              <span class="text-slate-600">
                Need a clinical opinion or quote?
              </span>
              <a
                href="/contact#book"
                class="font-bold text-[#0D9488] hover:text-[#0F766E] inline-flex items-center gap-1"
              >
                Book Dental Checkup <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Other Main Navigation Links -->
      {primaryNavItems.filter((i) => !i.hasDropdown).map((item) => {
        const isActive = pathname === item.href || (item.href !== "/" && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              "relative px-3 py-2 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap",
              isActive
                ? "text-[#0D9488] font-bold"
                : "text-[#475569] hover:text-[#0F2537] hover:bg-slate-50"
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
            {isActive && (
              <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-[#0D9488] rounded-full" aria-hidden="true"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right: Action Buttons -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Call Button on Desktop -->
      <a
        href="tel:+917018021512"
        class="hidden xl:inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold text-[#0F2537] bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl transition-all active:scale-95 whitespace-nowrap"
        aria-label="Call clinic directly"
      >
        <span class="text-[#0D9488]">📞</span>
        <span>+91 70180 21512</span>
      </a>

      <!-- Primary CTA: Book Appointment -->
      <a
        href="/contact#book"
        class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-[#0D9488] hover:bg-[#0F766E] rounded-xl shadow-xs transition-all duration-150 active:scale-95 whitespace-nowrap"
        aria-label="Book a dental consultation appointment"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Book Appointment</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-xl text-[#475569] hover:text-[#0F2537] hover:bg-slate-100 border border-[#E2E8F0] transition-colors cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div
    id="mobile-drawer-backdrop"
    class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-30 hidden lg:hidden transition-opacity"
    aria-hidden="true"
  ></div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-nav-drawer"
    class="hidden lg:hidden border-t border-[#E2E8F0] bg-white max-h-[calc(100dvh-5rem)] overflow-y-auto px-4 py-5 space-y-4 shadow-2xl relative z-40 transition-all"
  >
    <!-- Quick Search / Highlight Card -->
    <div class="p-3.5 bg-gradient-to-r from-teal-50 to-emerald-50 rounded-xl border border-teal-100/80 flex items-center justify-between">
      <div class="space-y-0.5">
        <span class="text-[11px] font-bold uppercase tracking-wider text-[#0D9488]">Doctor On Duty</span>
        <div class="text-xs font-bold text-[#0F2537]">Dr. Ashish Uniyal (Dental Surgeon)</div>
      </div>
      <a
        href="tel:+917018021512"
        class="px-2.5 py-1.5 bg-[#0D9488] text-white text-xs font-bold rounded-lg shadow-xs"
      >
        Call Now
      </a>
    </div>

    <!-- Navigation Links -->
    <div class="space-y-1">
      <a
        href="/"
        class:list={[
          "flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors",
          pathname === "/" ? "bg-[#E6FFFA] text-[#0D9488]" : "text-[#0F2537] hover:bg-slate-50"
        ]}
      >
        <span>Home</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <!-- Treatments Accordion for Mobile -->
      <div class="rounded-xl border border-slate-100 overflow-hidden bg-slate-50/50">
        <button
          type="button"
          id="mobile-treatments-toggle"
          class="w-full flex items-center justify-between px-3.5 py-3 text-sm font-semibold text-[#0F2537] hover:bg-slate-100 transition-colors text-left"
          aria-expanded="false"
        >
          <span class="flex items-center gap-2">
            <span>Clinical Treatments</span>
            <span class="text-[10px] uppercase font-bold bg-[#E6FFFA] text-[#0D9488] px-1.5 py-0.5 rounded">6 Care Areas</span>
          </span>
          <svg id="mobile-treatments-chevron" class="w-4 h-4 text-slate-500 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div id="mobile-treatments-content" class="hidden px-2 pb-2 space-y-1 border-t border-slate-100 pt-2 bg-white">
          {treatmentLinks.map((item) => (
            <a
              href={item.href}
              class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium text-slate-700 hover:text-[#0D9488] hover:bg-teal-50 transition-colors"
            >
              <span>{item.title}</span>
              <span class="text-[10px] text-slate-400">View</span>
            </a>
          ))}
          <a
            href="/treatments"
            class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-bold text-[#0D9488] hover:bg-teal-50 transition-colors pt-2 border-t border-slate-100"
          >
            <span>View Complete Treatment Guide</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Other Mobile Links -->
      <a
        href="/gallery"
        class:list={[
          "flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors",
          pathname.startsWith("/gallery") ? "bg-[#E6FFFA] text-[#0D9488]" : "text-[#0F2537] hover:bg-slate-50"
        ]}
      >
        <span>Before & After Smile Gallery</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/about"
        class:list={[
          "flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors",
          pathname.startsWith("/about") ? "bg-[#E6FFFA] text-[#0D9488]" : "text-[#0F2537] hover:bg-slate-50"
        ]}
      >
        <span>About Doctors & Clinical Standards</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/reviews"
        class:list={[
          "flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors",
          pathname.startsWith("/reviews") ? "bg-[#E6FFFA] text-[#0D9488]" : "text-[#0F2537] hover:bg-slate-50"
        ]}
      >
        <div class="flex items-center gap-2">
          <span>Patient Reviews</span>
          <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded">4.8★</span>
        </div>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/contact"
        class:list={[
          "flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors",
          pathname.startsWith("/contact") ? "bg-[#E6FFFA] text-[#0D9488]" : "text-[#0F2537] hover:bg-slate-50"
        ]}
      >
        <span>Contact & Directions</span>
        <span class="text-xs text-slate-400">→</span>
      </a>
    </div>

    <!-- Mobile Drawer Action Buttons -->
    <div class="pt-3 border-t border-[#E2E8F0] space-y-2">
      <a
        href="/contact#book"
        class="w-full flex items-center justify-center gap-2 py-3 px-4 text-xs font-bold rounded-xl bg-[#0D9488] text-white shadow-sm active:scale-98 transition-transform"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Book Appointment Consultation</span>
      </a>

      <div class="grid grid-cols-2 gap-2">
        <a
          href="tel:+917018021512"
          class="flex items-center justify-center gap-1.5 py-2.5 px-3 text-xs font-bold rounded-xl bg-[#0F2537] text-white shadow-xs"
        >
          <span>📞 Call Clinic</span>
        </a>
        <a
          href="https://wa.me/917018021512?text=Hello%20Uniyal%20Dental%20Clinic,%20I%20would%20like%20to%20book%20a%20consultation."
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-1.5 py-2.5 px-3 text-xs font-bold rounded-xl bg-[#25D366] text-white shadow-xs"
        >
          <span>💬 WhatsApp</span>
        </a>
      </div>

      <a
        href="https://maps.google.com/?q=Uniyal+Oro+Dental+Clinic+Balawala+Dehradun"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-2 px-3 text-xs font-semibold rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors"
      >
        <span>📍 Open Clinic in Google Maps</span>
      </a>
    </div>

    <!-- Quick Hours & Info in Mobile Drawer -->
    <div class="p-3 bg-slate-50 rounded-xl text-center text-xs text-slate-500 space-y-1">
      <div class="font-medium text-slate-700">Near Malsi Puliya, Balawala Main Road</div>
      <div>Mon–Sat: 9:30 AM–1:00 PM & 4:00 PM–9:00 PM</div>
      <div class="text-[11px] text-emerald-600 font-semibold">Regd. No-4135 · Wheelchair Accessible</div>
    </div>
  </div>
</header>

<script>
  function setupNavigation() {
    const btn = document.getElementById("mobile-menu-btn");
    const drawer = document.getElementById("mobile-nav-drawer");
    const backdrop = document.getElementById("mobile-drawer-backdrop");
    const openIcon = document.getElementById("menu-icon-open");
    const closeIcon = document.getElementById("menu-icon-close");

    // Dropdown Trigger (Desktop)
    const treatmentsTrigger = document.getElementById("treatments-menu-trigger");
    const treatmentsPanel = document.getElementById("treatments-dropdown-panel");
    const treatmentsChevron = document.getElementById("treatments-chevron");

    // Mobile Accordion
    const mobileTreatmentsToggle = document.getElementById("mobile-treatments-toggle");
    const mobileTreatmentsContent = document.getElementById("mobile-treatments-content");
    const mobileTreatmentsChevron = document.getElementById("mobile-treatments-chevron");

    function closeMobileMenu() {
      if (!btn || !drawer) return;
      btn.setAttribute("aria-expanded", "false");
      drawer.classList.add("hidden");
      if (backdrop) backdrop.classList.add("hidden");
      if (openIcon) openIcon.classList.remove("hidden");
      if (closeIcon) closeIcon.classList.add("hidden");
      document.body.style.overflow = "";
    }

    function openMobileMenu() {
      if (!btn || !drawer) return;
      btn.setAttribute("aria-expanded", "true");
      drawer.classList.remove("hidden");
      if (backdrop) backdrop.classList.remove("hidden");
      if (openIcon) openIcon.classList.add("hidden");
      if (closeIcon) closeIcon.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    if (btn) {
      btn.addEventListener("click", () => {
        const isExpanded = btn.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      });
    }

    if (backdrop) {
      backdrop.addEventListener("click", closeMobileMenu);
    }

    // Treatments toggle on mobile
    if (mobileTreatmentsToggle && mobileTreatmentsContent) {
      mobileTreatmentsToggle.addEventListener("click", () => {
        const isExpanded = mobileTreatmentsToggle.getAttribute("aria-expanded") === "true";
        mobileTreatmentsToggle.setAttribute("aria-expanded", String(!isExpanded));
        mobileTreatmentsContent.classList.toggle("hidden");
        if (mobileTreatmentsChevron) {
          mobileTreatmentsChevron.classList.toggle("rotate-180");
        }
      });
    }

    // Desktop Dropdown accessible click toggle
    if (treatmentsTrigger && treatmentsPanel) {
      treatmentsTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isExpanded = treatmentsTrigger.getAttribute("aria-expanded") === "true";
        treatmentsTrigger.setAttribute("aria-expanded", String(!isExpanded));
        treatmentsPanel.classList.toggle("hidden");
        if (treatmentsChevron) {
          treatmentsChevron.classList.toggle("rotate-180");
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener("click", (e) => {
        if (!treatmentsTrigger.contains(e.target as Node) && !treatmentsPanel.contains(e.target as Node)) {
          treatmentsTrigger.setAttribute("aria-expanded", "false");
          treatmentsPanel.classList.add("hidden");
          if (treatmentsChevron) {
            treatmentsChevron.classList.remove("rotate-180");
          }
        }
      });
    }

    // Close mobile menu on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeMobileMenu();
        if (treatmentsTrigger && treatmentsPanel) {
          treatmentsTrigger.setAttribute("aria-expanded", "false");
          treatmentsPanel.classList.add("hidden");
          if (treatmentsChevron) {
            treatmentsChevron.classList.remove("rotate-180");
          }
        }
      }
    });

    // Close mobile menu when clicking navigation links inside drawer
    if (drawer) {
      const links = drawer.querySelectorAll("a");
      for (const link of links) {
        link.addEventListener("click", () => {
          closeMobileMenu();
        });
      }
    }
  }

  setupNavigation();
  document.addEventListener("astro:after-swap", setupNavigation);
</script>
