---
// src/components/ui/Footer.astro
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Treatments & Tech", href: "/treatments" },
  { label: "Before & After Smile Gallery", href: "/gallery" },
  { label: "About Doctors & Standards", href: "/about" },
  { label: "Patient Reviews (4.8★)", href: "/reviews" },
  { label: "Contact & Directions", href: "/contact" },
];

const treatments = [
  { label: "Dental Implants & 3D Planning", href: "/treatments#implants" },
  { label: "Single-Sitting Laser RCT", href: "/treatments#rct" },
  { label: "Clear Aligners & Invisible Braces", href: "/treatments#aligners" },
  { label: "Smile Designing & Porcelain Veneers", href: "/treatments#cosmetic" },
  { label: "Pediatric & Preventive Fluoride", href: "/treatments#kids" },
  { label: "Ultrasonic Teeth Cleaning & Scaling", href: "/treatments#preventive" },
];
---

<footer class="border-t border-[#E2E8F0] bg-white text-[#0F2537] transition-colors duration-200 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: Clinic Overview -->
      <div class="space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-[#E6FFFA] border border-[#0D9488]/30 flex items-center justify-center text-[#0D9488]">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2C8.5 2 6 4.5 6 7.5c0 2 .8 4.2 1.5 6.5.8 2.5 1.5 5 2.5 7 1 .5 2 1 2 .5.5-2.5 1.2-5 2-7.5.7-2.3 1.5-4.5 1.5-6.5C18 4.5 15.5 2 12 2z"></path>
              <path d="M9.5 7.5a2.5 2.5 0 0 1 5 0"></path>
            </svg>
          </div>
          <span class="text-base font-bold tracking-tight text-[#0F2537]">
            Uniyal Oro Dental
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Gentle, pain-free dental care, precision titanium dental implants, and clear aligner orthodontics serving families across Balawala, Miyawala, Harrawala, and greater Dehradun.
        </p>
        <div class="flex items-center gap-2 text-xs font-semibold text-[#0F2537]">
          <span class="inline-flex items-center text-amber-500">★★★★★</span>
          <span>4.8 / 5.0 (43+ Verified Google Reviews)</span>
        </div>
        <div class="pt-1">
          <a
            href="/contact"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0D9488] hover:text-[#0F766E] hover:underline"
          >
            <span>Book Appointment Online</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation & Clinic Pages -->
      <div class="space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#0D9488]">
          Quick Navigation
        </h2>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-600">
          {navLinks.map((item) => (
            <li>
              <a href={item.href} class="hover:text-[#0D9488] transition-colors flex items-center justify-between group">
                <span>{item.label}</span>
                <span class="text-xs text-slate-300 group-hover:text-[#0D9488] transition-colors">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Key Treatments -->
      <div class="space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#0D9488]">
          Treatments & Care
        </h2>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-600">
          {treatments.map((t) => (
            <li>
              <a href={t.href} class="hover:text-[#0D9488] transition-colors">
                {t.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Location, Hours & Emergency -->
      <div class="space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#0D9488]">
          Contact & Timings
        </h2>
        <div class="space-y-2.5 text-xs sm:text-sm text-slate-600">
          <p class="leading-relaxed">
            <strong class="text-[#0F2537] block font-semibold">Clinic Address:</strong>
            Near Malsi Puliya, Balawala Main Road, Dehradun, Uttarakhand 248008 (Regd. No-4135)
          </p>
          <div class="space-y-0.5 text-xs">
            <p><span class="font-medium text-[#0F2537]">Mon–Sat:</span> 09:30 AM–01:00 PM & 04:00 PM–09:00 PM</p>
            <p><span class="font-medium text-[#0F2537]">Sunday:</span> <span class="text-emerald-600 font-semibold">By Prior Appointment</span></p>
          </div>
          <div class="pt-1 flex flex-col gap-1.5">
            <a href="tel:+917018021512" class="text-[#0D9488] hover:underline font-bold flex items-center gap-1.5">
              <span>📞 +91 70180 21512</span>
            </a>
            <a
              href="https://wa.me/917018021512?text=Hello%20Uniyal%20Dental%20Clinic,%20I%20would%20like%20to%20book%20a%20consultation."
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#25D366] hover:underline font-semibold flex items-center gap-1.5"
            >
              <span>💬 WhatsApp Consultation</span>
            </a>
            <a
              href="https://maps.google.com/?q=Uniyal+Oro+Dental+Clinic+Balawala+Dehradun"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-500 hover:text-slate-900 underline text-xs"
            >
              📍 Get Directions on Google Maps
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-[#E2E8F0] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        © {currentYear} Uniyal Oro Dental Clinic & Implant Centre. Regd. No-4135. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <span>Balawala · Miyawala · Nakronda · Harrawala</span>
        <a href="/contact" class="hover:text-[#0D9488] underline">Directions & Booking</a>
      </div>
    </div>
  </div>
</footer>
