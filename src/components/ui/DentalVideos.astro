---
// src/components/ui/DentalVideos.astro
const videos = [
  {
    title: "How Computer-Guided Dental Implants Work",
    desc: "Understand titanium root placement with 3D precision imaging and zero discomfort.",
    duration: "1 min watch",
    category: "Implants",
  },
  {
    title: "Step-by-Step Single-Sitting Painless RCT",
    desc: "Watch how microscopic rotary instruments clear deep tooth infection smoothly.",
    duration: "1.5 min watch",
    category: "Painless RCT",
  },
  {
    title: "Clear Invisible Aligners Transformation",
    desc: "Digital 3D simulation of teeth moving into alignment without metallic brackets.",
    duration: "1 min watch",
    category: "Aligners",
  },
];
---

<section class="py-16 bg-slate-900 text-white" id="treatment-simulations">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-10">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="text-xs font-black uppercase tracking-wider text-[#0D9488] bg-teal-950/60 px-3 py-1 rounded-full border border-teal-800">
        Clinical Education & Visual Guides
      </span>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Understand Your Dental Procedure
      </h2>
      <p class="text-base text-slate-300 leading-relaxed">
        We believe an informed patient is a relaxed patient. Watch these quick visual guides to learn how modern treatments remain completely pain-free.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {videos.map((vid, idx) => (
        <div class="rounded-2xl overflow-hidden border border-slate-700 bg-slate-800/80 p-5 space-y-4 hover:border-[#0D9488] transition-colors">
          <div class="h-44 rounded-xl bg-slate-950/90 border border-slate-700 flex flex-col items-center justify-center relative group cursor-pointer overflow-hidden">
            <!-- Simulated Video Play Interface -->
            <div class="w-14 h-14 rounded-full bg-[#0D9488] text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
            <div class="absolute bottom-2.5 right-3 text-[10px] font-bold px-2 py-0.5 rounded bg-black/80 text-white">
              {vid.duration}
            </div>
            <div class="absolute top-2.5 left-3 text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-[#0D9488] text-white">
              {vid.category}
            </div>
          </div>

          <div class="space-y-1.5 text-left">
            <h3 class="text-base font-bold text-white">
              {vid.title}
            </h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              {vid.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
