---
// src/components/ui/GoogleMapSection.astro
---

<section class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 space-y-10" id="location-direction" aria-labelledby="clinic-location-heading">
  <div class="text-center max-w-3xl mx-auto space-y-3">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E6FFFA] border border-[#0D9488]/40 text-xs font-black text-[#0D9488] uppercase tracking-wider">
      <span>📍 Clinic Location & Directions</span>
    </div>
    <h2 id="clinic-location-heading" class="text-3xl sm:text-5xl font-black text-[#0F2537] tracking-tight">
      Visit Us in Balawala, Dehradun
    </h2>
    <p class="text-base sm:text-lg text-[#334155] font-medium leading-relaxed">
      Conveniently situated right on Balawala Main Road near Malsi Puliya. Ground floor facility with street-level wheelchair accessibility and dedicated patient vehicle parking.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    <!-- Interactive Map Iframe Container (7 cols) -->
    <div class="lg:col-span-7 rounded-3xl overflow-hidden border-2 border-[#CBD5E1] shadow-lg bg-slate-100 flex flex-col justify-between min-h-[420px] relative">
      <!-- Embedded Google Map -->
      <iframe
        title="Uniyal Oro Dental Clinic Balawala Dehradun Map Location"
        src="https://maps.google.com/maps?q=30.2789,78.1065&t=&z=15&ie=UTF8&iwloc=&output=embed"
        class="w-full h-full min-h-[380px] border-0"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>

      <!-- Map Overlay Bottom Strip -->
      <div class="bg-white/95 backdrop-blur-md p-4 border-t border-[#CBD5E1] flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2 font-bold text-[#0F2537]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#0D9488] animate-pulse"></span>
          <span>Balawala Main Road, near Malsi Puliya, Dehradun 248008</span>
        </div>
        <a
          href="https://maps.google.com/?q=Uniyal+Oro+Dental+Clinic+Balawala+Dehradun"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 bg-[#0D9488] hover:bg-[#0F766E] text-white font-extrabold rounded-xl shadow-xs transition-colors inline-flex items-center gap-1.5"
        >
          <span>Open in Google Maps App</span>
          <span>↗</span>
        </a>
      </div>
    </div>

    <!-- Direction Guidance & Commute Details (5 cols) -->
    <div class="lg:col-span-5 rounded-3xl border-2 border-[#CBD5E1] bg-white p-6 sm:p-8 shadow-sm flex flex-col justify-between space-y-6">
      <div class="space-y-5">
        <div class="border-b border-slate-100 pb-4">
          <span class="text-xs font-black uppercase tracking-wider text-[#0D9488]">
            Transit & Landmarks
          </span>
          <h3 class="text-xl sm:text-2xl font-black text-[#0F2537] mt-1">
            How to Reach Us
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">
            Centrally connected to Harrawala, Miyawala, Nakronda, and Ring Road Dehradun.
          </p>
        </div>

        <!-- Landmark 1 -->
        <div class="flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-lg bg-teal-50 border border-[#0D9488]/30 flex items-center justify-center shrink-0 text-[#0D9488] font-black text-xs">
            01
          </div>
          <div>
            <h4 class="text-sm font-extrabold text-[#0F2537]">Near Malsi Puliya Landmark</h4>
            <p class="text-xs text-slate-600 leading-relaxed mt-0.5">
              Located directly on the Balawala main thoroughfare, 100 meters from the Malsi Puliya crossing. High visibility roadside signage.
            </p>
          </div>
        </div>

        <!-- Landmark 2 -->
        <div class="flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-lg bg-teal-50 border border-[#0D9488]/30 flex items-center justify-center shrink-0 text-[#0D9488] font-black text-xs">
            02
          </div>
          <div>
            <h4 class="text-sm font-extrabold text-[#0F2537]">By Public Bus, Auto & Vikram</h4>
            <p class="text-xs text-slate-600 leading-relaxed mt-0.5">
              Vikram route #5 and Balawala local auto-rickshaws stop directly in front of the clinic. Request the driver for "Malsi Puliya Dental Clinic".
            </p>
          </div>
        </div>

        <!-- Landmark 3 -->
        <div class="flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-lg bg-teal-50 border border-[#0D9488]/30 flex items-center justify-center shrink-0 text-[#0D9488] font-black text-xs">
            03
          </div>
          <div>
            <h4 class="text-sm font-extrabold text-[#0F2537]">Parking & Accessibility</h4>
            <p class="text-xs text-slate-600 leading-relaxed mt-0.5">
              Dedicated two-wheeler and four-wheeler front parking bay. Step-free level entrance suitable for elderly patients and wheelchair users.
            </p>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row gap-3">
        <a
          href="/directions"
          class="flex-1 inline-flex items-center justify-center gap-1.5 py-3 px-4 rounded-xl text-xs font-black text-white bg-[#0F2537] hover:bg-slate-800 transition-colors shadow-xs"
        >
          <span>View Detailed Directory & Routes</span>
          <span>→</span>
        </a>
        <a
          href="tel:+917018021512"
          class="inline-flex items-center justify-center gap-1.5 py-3 px-4 rounded-xl text-xs font-bold text-[#0D9488] bg-[#E6FFFA] hover:bg-teal-100 border border-[#0D9488]/30 transition-colors"
        >
          <span>📞 Call for Help</span>
        </a>
      </div>
    </div>
  </div>
</section>
